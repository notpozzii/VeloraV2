{
  "name": "galaxyv7",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "vite dev",
    "build": "vite build && node scripts/build-sites.mjs",
    "export:s3": "node scripts/export-s3.mjs",
    "changelog": "node scripts/changelog.js",
    "preview": "wrangler dev --config wrangler.sites.jsonc",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "gen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "prebuild": "node scripts/copy-browser-assets.mjs",
    "postbuild": "printf '\\n**/.git/**\\n' >> .svelte-kit/cloudflare/.assetsignore",
    "build:cloudflare": "wrangler types && vite build"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^26.1.0",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "wrangler": "^4.97.0",
    "esbuild": "0.27.7"
  },
  "dependencies": {
    "@devmischief/shaders-svelte": "^0.0.9",
    "@fastify/static": "^8.3.0",
    "@mercuryworkshop/bare-as-module3": "^2.2.5",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/epoxy-transport": "^2.1.28",
    "@mercuryworkshop/libcurl-transport": "^1.5.2",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "@nightnetwork/reflux": "^2.2.0",
    "dotenv": "^17.4.2",
    "extract-colors": "^4.2.1",
    "fastify": "^5.8.5",
    "favicon-fetch": "^1.0.0",
    "gsap": "^3.15.0",
    "localspace": "^1.3.0",
    "origin-snapshot": "^0.1.2"
  },
  "patchedDependencies": {
    "@mercuryworkshop/libcurl-transport@1.5.2": "patches/@mercuryworkshop%2Flibcurl-transport@1.5.2.patch"
  },
  "packageManager": "bun@1.4.2"
}
