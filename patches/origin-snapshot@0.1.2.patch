@@ -17,7 +17,14 @@ export function dumpWebStorage(storage) {
  * @param {Record<string, string>} data
  * @param {{ clear?: boolean }} [options]
  */
-export function restoreWebStorage(storage, data, { clear = false } = {}) {
-	if (clear) storage.clear();
