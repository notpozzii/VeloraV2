+export function restoreWebStorage(storage, data, { clear = false, preserveKeys = [] } = {}) {
+	const preserved = new Set(preserveKeys);
+	if (clear) {
+		if (!preserved.size) storage.clear();
+		else for (let i = storage.length - 1; i >= 0; i--) {
+			const key = storage.key(i);
+			if (key !== null && !preserved.has(key)) storage.removeItem(key);
+		}
+	}
+	for (const [key, value] of Object.entries(data)) if (!preserved.has(key)) storage.setItem(key, value);
 }
